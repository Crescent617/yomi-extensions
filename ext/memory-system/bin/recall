#!/usr/bin/env bash
# recall — capped ripgrep over an agent's memory/ directory.
# Usage: recall <keyword>
#   tier 0 hot (NOW.md — in-flight work): first, 10-line cap;
#   tier 1 evergreen (top-level *.md except NOW.md/archive.md, plus friend//group//knowledge/): 30-line cap;
#   tier 2 dated (worklog/diary/dream/janitor): newest-first, 50-line cap;
#   tier 3 cold (archive.md — superseded info): last, 30-line cap;
#   20 matches per file, long lines truncated at 200 chars.
# Root: $RECALL_ROOT, else walk up from $PWD to the first directory holding memory/.
set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: recall <keyword>" >&2; exit 2; }
kw="$1"

root="${RECALL_ROOT:-}"
if [[ -z "$root" ]]; then
  d="$PWD"
  while true; do
    if [[ -d "$d/memory" ]]; then root="$d"; break; fi
    if [[ "$d" == "/" ]]; then break; fi
    d="$(dirname "$d")"
  done
fi
if [[ -z "$root" || ! -d "$root/memory" ]]; then
  echo "recall: no memory/ found (set RECALL_ROOT)" >&2
  exit 1
fi

m="$root/memory"
evergreen=()
for f in "$m"/*.md; do
  [[ -e "$f" ]] || continue
  case "$(basename "$f")" in archive.md | NOW.md) continue ;; esac
  evergreen+=("$f")
done
for d in friend group knowledge; do
  if [[ -d "$m/$d" ]]; then evergreen+=("$m/$d"); fi
done
dated=()
for d in diary worklog dream janitor; do
  if [[ -d "$m/$d" ]]; then dated+=("$m/$d"); fi
done

opts=(-i -m 20 --max-columns 200 --max-columns-preview --with-filename)

# tier 0, hot: NOW.md — in-flight work, 10-line cap
if [[ -f "$m/NOW.md" ]]; then
  rg "${opts[@]}" -- "$kw" "$m/NOW.md" 2>/dev/null | head -n 10 || true
fi
# tier 1, evergreen: stable order, 30-line cap
if ((${#evergreen[@]})); then
  rg "${opts[@]}" -- "$kw" "${evergreen[@]}" 2>/dev/null | head -n 30 || true
fi
# tier 2, dated: prepend the file's date as sort key, newest first, 50-line cap
if ((${#dated[@]})); then
  rg "${opts[@]}" -- "$kw" "${dated[@]}" 2>/dev/null \
    | sed -E 's#^.*/([0-9]{4}-[0-9]{2}-[0-9]{2})\.md:#\1 &#' \
    | sort -r | cut -d' ' -f2- | head -n 50 || true
fi
# tier 3, cold: archive.md holds superseded info — comes last, 30-line cap
if [[ -f "$m/archive.md" ]]; then
  rg "${opts[@]}" -- "$kw" "$m/archive.md" 2>/dev/null | head -n 30 || true
fi
exit 0
